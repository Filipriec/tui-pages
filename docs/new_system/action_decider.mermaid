flowchart TB
    subgraph INPUTS
        PR[PipelineResponse]
        FI[FocusTarget]
        PI[PageIdentifier]
    end

    subgraph ActionDecider
        CHK1{is_global_logic?}
        CHK2{check_capability?}
        CHK3{Focus type?}
        
        CHK1 -->|yes| GL[GlobalLogic]
        CHK1 -->|no| CHK2
        CHK2 -->|yes| PL[PageLogic]
        CHK2 -->|no| CHK3
        
        CHK3 -->|CanvasField| CL[CanvasLogic]
        CHK3 -->|UIElement| PL2[PageLogic]
        CHK3 -->|Sidebar/CommandBar| GL2[GlobalLogic]
    end

    subgraph OUTPUTS
        AR1[PageLogic page_id + action]
        AR2[CanvasLogic action]
        AR3[GlobalLogic action]
        AR4[Type / Wait / Unresolved]
    end

    PR --> CHK1
    FI --> CHK3
    PI --> PL
    PI --> PL2
    
    GL --> AR3
    GL2 --> AR3
    PL --> AR1
    PL2 --> AR1
    CL --> AR2
