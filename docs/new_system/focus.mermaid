flowchart TB
    subgraph TARGET[Stage 3 - Target State]
        subgraph PageLoaders[Page Loaders]
            PL1[LoginPage::load]
            PL2[FormPage::load]
            PL3[AdminPage::load]
        end

        subgraph FM[FocusManager - Single Source]
            RT[register_targets]
            TG[targets]
            CT[current_target]
            IF[is_focused]
        end
    end

    subgraph CONSUMERS[Consumers]
        IO[InputOrchestrator]
        AD[ActionDecider]
        UI[UI Rendering]
    end

    PageLoaders -->|register on init| RT
    RT --> TG
    TG --> CT
    CT --> IO
    CT --> AD
    IF --> UI
